<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StudWalls.Desktop.ViewModels"
        x:Class="StudWalls.Desktop.Views.WallEditorDialog"
        x:DataType="vm:WallEditorViewModel"
        Title="Wall Configuration &amp; Tributary Loads"
        Width="1020" Height="700"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto" Margin="10">
        <!-- Main Split: Walls List on Left, Properties & Tabs on Right -->
        <Grid Grid.Row="0" ColumnDefinitions="220,12,*">
            <!-- Walls List on Left (similar to Materials and Studs dialogs) -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Walls" FontWeight="Bold" Margin="0,0,0,6"/>
                <ListBox ItemsSource="{Binding Walls}" SelectedItem="{Binding SelectedWall}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Wall Configuration on Right -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*">
                <!-- Top Wall Dimensions & Vertical Span -->
                <Border Grid.Row="0" BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="100,*,100,*,100,*">
                            <TextBlock Grid.Column="0" Text="Wall Name:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding WallName}" Margin="0,0,10,0"/>

                            <TextBlock Grid.Column="2" Text="Length (mm):" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="3" Text="{Binding Length}" Margin="0,0,10,0"/>

                            <TextBlock Grid.Column="4" Text="SW (kPa):" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="5" Text="{Binding SelfWeight}"/>
                        </Grid>

                        <Grid ColumnDefinitions="100,*,100,*,Auto">
                            <TextBlock Grid.Column="0" Text="Bottom Story:" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableStories}" SelectedItem="{Binding BottomStory}" HorizontalAlignment="Stretch" Margin="0,0,10,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Column="2" Text="Top Story:" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="3" ItemsSource="{Binding AvailableStories}" SelectedItem="{Binding TopStory}" HorizontalAlignment="Stretch" Margin="0,0,10,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Grid.Column="4" Content="Update Story Span" Command="{Binding UpdateLevelSpanCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Middle Content Tabs: 1) Tributary Widths Table, 2) Story Loads Assignment -->
                <TabControl Grid.Row="1">
                    <!-- Tab 1: Tributary Widths and Unsupported Lengths (CSA O86-20 Cl 6.5.6.2.2) -->
                    <TabItem Header="Tributary Widths &amp; Buckling Lengths">
                        <DataGrid ItemsSource="{Binding WallStories}" SelectedItem="{Binding SelectedWallStory}" AutoGenerateColumns="False" CanUserResizeColumns="True" GridLinesVisibility="All">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Level" Binding="{Binding Story.Name}" IsReadOnly="True" Width="120"/>
                                <DataGridTextColumn Header="Left Trib (mm)" Binding="{Binding TribWidthLeft, StringFormat={}{0:F0}}" Width="*"/>
                                <DataGridTextColumn Header="Right Trib (mm)" Binding="{Binding TribWidthRight, StringFormat={}{0:F0}}" Width="*"/>
                                <DataGridTextColumn Header="Weak Axis Lu (mm)" Binding="{Binding LuWidth, StringFormat={}{0:F0}}" Width="*"/>
                                <DataGridTextColumn Header="Strong Axis Lu (mm)" Binding="{Binding LuDepth, StringFormat={}{0:F0}}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- Tab 2: Assigned Loads (Left / Right) -->
                    <TabItem Header="Assigned Story Loads">
                        <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                                <TextBlock Text="Select Story to Assign Loads:" VerticalAlignment="Center" FontWeight="Bold"/>
                                <ComboBox ItemsSource="{Binding WallStories}" SelectedItem="{Binding SelectedWallStory}" Width="200">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Story.Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <Grid Grid.Row="1" ColumnDefinitions="*,10,*,10,*">
                                <!-- Available Loads -->
                                <DockPanel Grid.Column="0">
                                    <TextBlock DockPanel.Dock="Top" Text="Available Project Loads" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <ListBox ItemsSource="{Binding AvailableLoads}" SelectedItem="{Binding SelectedAvailableLoad}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>

                                <!-- Left Tributary Loads -->
                                <DockPanel Grid.Column="2">
                                    <TextBlock DockPanel.Dock="Top" Text="Left Tributary Loads" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" Margin="0,4,0,0">
                                        <Button Content="&lt;- Add Left" Command="{Binding AddLoadLeftCommand}"/>
                                        <Button Content="Remove" Command="{Binding RemoveLoadLeftCommand}"/>
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding CurrentStoryLoadsLeft}" SelectedItem="{Binding SelectedLeftLoad}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>

                                <!-- Right Tributary Loads -->
                                <DockPanel Grid.Column="4">
                                    <TextBlock DockPanel.Dock="Top" Text="Right Tributary Loads" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" Margin="0,4,0,0">
                                        <Button Content="&lt;- Add Right" Command="{Binding AddLoadRightCommand}"/>
                                        <Button Content="Remove" Command="{Binding RemoveLoadRightCommand}"/>
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding CurrentStoryLoadsRight}" SelectedItem="{Binding SelectedRightLoad}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- Bottom Action Bar (similar to Materials and Studs dialogs) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button Content="New Wall" Command="{Binding NewWallCommand}"/>
            <Button Content="Save Wall" Command="{Binding SaveWallCommand}"/>
            <Button Content="Delete Wall" Command="{Binding DeleteWallCommand}"/>
            <Button Content="Close" Command="{Binding CloseCommand}"/>
        </StackPanel>
    </Grid>
</Window>
