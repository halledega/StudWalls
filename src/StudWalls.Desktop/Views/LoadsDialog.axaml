<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StudWalls.Desktop.ViewModels"
        xmlns:enums="using:StudWalls.Core.Enums"
        x:Class="StudWalls.Desktop.Views.LoadsDialog"
        x:DataType="vm:LoadsViewModel"
        Title="Define Loads (Specified Design Loads)"
        Width="680" Height="460"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto,Auto" Margin="10">
        <!-- Loads DataGrid -->
        <DataGrid Grid.Row="0" ItemsSource="{Binding Loads}" SelectedItem="{Binding SelectedLoad}" AutoGenerateColumns="False" CanUserResizeColumns="True" GridLinesVisibility="All">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Load Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Case" Binding="{Binding Case}" Width="*"/>
                <DataGridTextColumn Header="Value (kPa)" Binding="{Binding Value, StringFormat={}{0:F2}}" Width="*"/>
                <DataGridTextColumn Header="Distribution" Binding="{Binding LoadType}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Edit Form -->
        <Grid Grid.Row="1" ColumnDefinitions="60,*,50,*,50,*,50,*" RowDefinitions="Auto" Margin="0,10,0,0">
            <TextBlock Grid.Column="0" Text="Name:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding EditName}" Margin="0,0,8,0"/>

            <TextBlock Grid.Column="2" Text="Case:" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="3" ItemsSource="{Binding AvailableCases}" SelectedItem="{Binding EditCase}" HorizontalAlignment="Stretch" Margin="0,0,8,0"/>

            <TextBlock Grid.Column="4" Text="Value:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="5" Text="{Binding EditValue}" Margin="0,0,8,0"/>

            <TextBlock Grid.Column="6" Text="Type:" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="7" SelectedItem="{Binding EditType}" HorizontalAlignment="Stretch">
                <enums:LoadType>Area</enums:LoadType>
                <enums:LoadType>Line</enums:LoadType>
                <enums:LoadType>Point</enums:LoadType>
            </ComboBox>
        </Grid>

        <!-- Bottom Action Bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button Content="Add Load" Command="{Binding AddLoadCommand}" />
            <Button Content="Save Load" Command="{Binding SaveLoadCommand}" />
            <Button Content="Delete Load" Command="{Binding DeleteLoadCommand}" />
            <Button Content="Close" Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</Window>
