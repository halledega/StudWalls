<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StudWalls.Desktop.ViewModels"
        x:Class="StudWalls.Desktop.Views.ReportWindow"
        x:DataType="vm:ReportViewModel"
        Title="Structural Design Report Preview"
        Width="960" Height="720"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto" Margin="10">
        <!-- Report Content Preview (Read-only Monospace) -->
        <TextBox Grid.Row="0" Text="{Binding ReportContent}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Monospace" FontSize="12" />

        <!-- Bottom Action Bar with PDF Export -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="DarkGreen" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Export to PDF..." Command="{Binding ExportPdfCommand}" FontWeight="Bold"/>
                <Button Content="Close" Command="{Binding CloseCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
