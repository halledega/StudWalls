<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StudWalls.Desktop.ViewModels"
        x:Class="StudWalls.Desktop.Views.LoadCombosDialog"
        x:DataType="vm:LoadCombosViewModel"
        Title="Define Load Combinations (NBCC ULS)"
        Width="740" Height="500"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto" Margin="10">
        <!-- Main Split: Combos on Left, Factors Table on Right -->
        <Grid Grid.Row="0" ColumnDefinitions="240,10,*">
            <!-- Combinations List -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,6,0,0">
                    <TextBox Text="{Binding EditName}" />
                    <UniformGrid Columns="2">
                        <Button Content="Add Combo" Command="{Binding AddCombinationCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Content="Save Name" Command="{Binding SaveCombinationNameCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </UniformGrid>
                    <Button Content="Delete Combo" Command="{Binding DeleteCombinationCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </StackPanel>

                <ListBox ItemsSource="{Binding Combinations}" SelectedItem="{Binding SelectedCombo}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Items DataGrid and Add Row Panel -->
            <Grid Grid.Column="2" RowDefinitions="*,Auto">
                <DataGrid Grid.Row="0" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" CanUserResizeColumns="True" GridLinesVisibility="All">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Load Case" Binding="{Binding Load.Name}" Width="*"/>
                        <DataGridTextColumn Header="Case Category" Binding="{Binding Load.Case}" Width="*"/>
                        <DataGridTextColumn Header="Multiplier Factor" Binding="{Binding Factor, StringFormat={}{0:F2}}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Add / Remove Item Row -->
                <StackPanel Grid.Row="1" Spacing="6" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="Auto,*,Auto,80">
                        <TextBlock Grid.Column="0" Text="Load: " VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableLoads}" SelectedItem="{Binding SelectedLoadForNewItem}" HorizontalAlignment="Stretch" Margin="0,0,8,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Column="2" Text="Factor: " VerticalAlignment="Center"/>
                        <TextBox Grid.Column="3" Text="{Binding NewFactor}" />
                    </Grid>

                    <UniformGrid Columns="2">
                        <Button Content="Add Load to Combo" Command="{Binding AddItemToComboCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Content="Remove Selected Row" Command="{Binding RemoveItemFromComboCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Bottom Action Bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button Content="Close" Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</Window>
