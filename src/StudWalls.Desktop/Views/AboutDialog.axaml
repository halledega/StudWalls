<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StudWalls.Desktop.ViewModels"
        x:Class="StudWalls.Desktop.Views.AboutDialog"
        x:DataType="vm:AboutViewModel"
        Title="About StudWalls"
        Width="540" Height="360"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid RowDefinitions="*,Auto" Margin="16">
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="{Binding AppTitle}" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="{Binding Version}" Foreground="Gray"/>
            <Separator Margin="0,4"/>
            <TextBlock Text="{Binding Standards}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding License}" FontWeight="SemiBold" Foreground="DarkGreen"/>
            <Separator Margin="0,4"/>
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
        </StackPanel>

        <Button Grid.Row="1" Content="Close" Command="{Binding CloseCommand}" HorizontalAlignment="Right"/>
    </Grid>
</Window>
