<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StudWalls.Desktop.ViewModels"
        x:Class="StudWalls.Desktop.Views.LevelsDialog"
        x:DataType="vm:LevelsViewModel"
        Title="Define Levels (Stories &amp; Heights)"
        Width="680" Height="460"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto,Auto" Margin="10">
        <!-- Stories DataGrid -->
        <DataGrid Grid.Row="0" ItemsSource="{Binding Stories}" SelectedItem="{Binding SelectedStory}" AutoGenerateColumns="False" CanUserResizeColumns="True" GridLinesVisibility="All">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Level Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Height (mm)" Binding="{Binding Height, StringFormat={}{0:F0}}" Width="*"/>
                <DataGridTextColumn Header="Floor Thickness (mm)" Binding="{Binding FloorThickness, StringFormat={}{0:F0}}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Edit Form -->
        <StackPanel Grid.Row="1" Spacing="6" Margin="0,10,0,0">
            <Grid ColumnDefinitions="140,*,140,*,140,*" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Level Name:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding EditName}" Margin="0,0,8,0"/>

                <TextBlock Grid.Column="2" Text="Height (mm):" VerticalAlignment="Center"/>
                <TextBox Grid.Column="3" Text="{Binding EditHeight}" Margin="0,0,8,0"/>

                <TextBlock Grid.Column="4" Text="Thickness (mm):" VerticalAlignment="Center"/>
                <TextBox Grid.Column="5" Text="{Binding EditFloorThickness}"/>
            </Grid>
            <TextBlock Text="{Binding WarningMessage}" Foreground="Red" />
        </StackPanel>

        <!-- Bottom Action Bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button Content="Add Level" Command="{Binding AddStoryCommand}" />
            <Button Content="Save Level" Command="{Binding SaveStoryCommand}" />
            <Button Content="Delete Level" Command="{Binding DeleteStoryCommand}" />
            <Button Content="Close" Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</Window>
